      <!-- <geom name="box_right" type="box" size="0.005 0.135 0.1775" pos="0.275 0.135 0.175" material="gray_mat" contype="1" conaffinity="1"/> -->
      <geom name="box_left" type="box" size="0.005 0.135 0.1775" pos="-0.005 0.135 0.175" material="gray_mat" contype="1" conaffinity="1"/>
    </body>

    <!-- ===== -->
    <!-- FRAME -->
    <!-- ===== -->
